  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.build.json && pkgroll",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "dev": "dotenv  -e  .env.development.local -e .env.development -- tsx watch src/index.ts | pino-pretty",
    "test": "dotenv -e .env.test -- vitest"
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "awilix": "^13.0.3",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pg": "^8.20.0",
    "pg-chain": "^1.1.3",
    "pino": "^10.3.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pkgroll": "^2.27.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
