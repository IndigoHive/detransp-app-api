# Peça para outro dev te passar os valores

PORT=""
DATABASE_URL=""
NODE_ENV=""
# Ambiente de deploy desta instância ("development" | "staging" | "production").
# Separado de NODE_ENV porque o buildpack Node do Heroku força NODE_ENV="production" em
# todo dyno — use APP_ENV="staging" no dyno de homolog para liberar os escape hatches
# de dev/QA abaixo (TDV_MOCK_*, LIVENESS_BYPASS_MATCH). Vazio = cai no NODE_ENV.
APP_ENV=""
LOG_LEVEL=""

# IDSP (GovBR) — Homologação
GOVBR_IDSP_AUTHORIZE_URL=""
GOVBR_IDSP_IOS_CLIENT_ID=""
GOVBR_IDSP_IOS_CLIENT_SECRET=""
GOVBR_IDSP_ANDROID_CLIENT_ID=""
GOVBR_IDSP_ANDROID_CLIENT_SECRET=""
GOVBR_IDSP_ANDROID_REDIRECT_URI=""
GOVBR_IDSP_IOS_REDIRECT_URI=""
GOVBR_IDSP_TOKEN_URL=""
GOVBR_IDSP_USERINFO_URL=""
SESSION_ENCRYPTION_KEY=""

# ServiceNow CSM — Homologação (Basic Auth — vistoria em trânsito)
SERVICENOW_CSM_BASE_URL=""
SERVICENOW_CSM_USERNAME=""
SERVICENOW_CSM_PASSWORD=""

# ServiceNow API — Homologação (Bearer token — dashboard, veículos, CNH, débitos)
SERVICENOW_API_BASE_URL=""
SERVICENOW_API_DASHBOARD_BASE_PATH=""
SERVICENOW_API_CONSULTA_DEBITOS_BASE_PATH=""

# ROTA Caixa Postal — Homologação (notificações push)
ROTA_CAIXA_POSTAL_BASE_URL=""
ROTA_CAIXA_POSTAL_APP_TOPIC=""

# Rota SP - Homologação (Liveness)
ROTA_VIDA_BASE_URL=""
# Dev/QA only (ignorado quando APP_ENV="production"): pula o upload da foto e o /match/v3
# real, tratando a biometria como conferida. Para testar o fluxo TDV sem passar pelo
# liveness de verdade.
LIVENESS_BYPASS_MATCH=""
# ROTA_ARQUIVOS_BASE_URL=""
ROTA_CAIXA_POSTAL_BASE_URL=""

# Rota SP - Homologação (Pesquisa de Peças)
ROTA_CRV_PECAS_BASE_URL=""
ROTA_VISTORIAS_BASE_URL=""

# ITI — Homologação (assinatura eletrônica; client_id/redirect_uri precisam bater com o
# que está registrado no ITI para este app)
ITI_BASE_URL=""
ITI_CLIENT_ID=""
ITI_REDIRECT_URI=""

# TDV MOCK — Dev/QA only (nunca em produção). Quando TDV_MOCK_ENABLED="true", o serviço TDV
# roda contra um mock in-memory stateful (login gov.br e demais serviços continuam reais):
# massa semeada, criação/estados da TDV em memória e prova de vida/PIX fake, para rodar o
# fluxo inteiro sem depender do ServiceNow. Os dados seguem os exemplos de resposta real do
# docs/tdv/swagger.yaml (sys_id de 32 hex, CPF com 11 dígitos, CNPJ com 14, erros em HTTP 406
# com o envelope { error: { message, detail }, status: "failure" }).
# SELLER_CPF/BUYER_CPF são os CPFs de homolog que você vai logar como vendedor e comprador.
TDV_MOCK_ENABLED=""
TDV_MOCK_SELLER_CPF=""
TDV_MOCK_BUYER_CPF=""
# Qual versão da TDV a massa reproduz (default "1.0"). Cada versão semeia o que o ServiceNow
# devolveria para ela, com a origem certa — ver docs/tdv/tdv-versoes-implementacao.md.
#   1.0  origem 1      · jornada do VENDEDOR. Massa vazia: o fluxo cria a TDV do zero.
#   2.0  origem 2 e 3  · jornada do COMPRADOR. Duas comunicações de venda (e-Notariado + CDT),
#                        sem estado e sem código — é assim que essa jornada realmente começa.
#   3.0  origem 4      · jornada do COMPRADOR. Uma CV com a LOJA (CNPJ) como vendedora.
#   4.0  origem 5      · jornada do VENDEDOR. TDV já aberta pelo lojista via SERPRO (estado 1),
#                        com a loja (CNPJ) como compradora.
#   6.0  origem 6      · jornada do COMPRADOR. CV de cartório — o fluxo chama validar-tdv antes.
TDV_MOCK_VERSAO=""
# Opcionais (têm default): placa/renavam do veículo semeado
TDV_MOCK_VEHICLE_PLATE=""
TDV_MOCK_VEHICLE_RENAVAM=""
# Opcional: pula direto para um estado da TDV (já com vendedor/comprador/dados da venda
# preenchidos) em vez de começar de onde a versão escolhida normalmente começa — útil para
# testar só um trecho do fluxo. Requer TDV_MOCK_SELLER_CPF e TDV_MOCK_BUYER_CPF preenchidos.
# Nas jornadas do comprador (2.0/3.0/6.0), deixar em branco mantém a comunicação de venda
# crua (sem estado e sem código); preencher já a promove a uma TDV naquele estado.
# 1 VEICULO_SELECIONADO · 2 DADOS_VENDA_INFORMADOS · 3 ATPVE_CRIADA
# 4 INTENCAO_COMPRA_CONFIRMADA · 5 AUTODECLARACAO_RESIDENCIA_CONFIRMADA
# 6 ATPVE_ASSINADA_COMPRADOR (falta vendedor assinar) · 7 ATPVE_ASSINADA_VENDEDOR... (falta comprador pagar)
# 8 TAXA_SERVICO_PAGA · 9 TRANSFERENCIA_CONCLUIDA · 10 TRANSFERENCIA_CANCELADA
TDV_MOCK_INITIAL_ESTADO=""
# Dev/QA-only escape hatches (nunca em produção) para testar telas de erro que os dados mock
# não conseguem disparar sozinhos. Funcionam com ou sem TDV_MOCK_ENABLED.
# "Veículo com restrição" (toast na Análise de Requisitos) — o check real ainda não existe.
TDV_MOCK_FORCE_VEHICLE_RESTRICTION=""
# Tela "Erro placa" (cidade do comprador diferente da do veículo, placa não-Mercosul).
TDV_MOCK_FORCE_CIDADES_DIFERENTES=""
# Faz o POST /transferencias-de-veiculos falhar com a pendência escolhida, para chegar nas
# telas de pendência das jornadas do comprador (2.0/3.0/6.0). Vazio = caminho feliz.
# pagamento_pendente | vistoria_pendente | vistoria_pagamento_pendentes
# administrativa_pendente | judicial_pendente | administrativa_judicial_pendentes
TDV_MOCK_PENDENCIA=""
# Só TDV 6.0: faz o validar-tdv reprovar a comunicação de venda. Vazio = aprova.
# duas_assinaturas | duas_pessoas_fisicas
TDV_MOCK_VALIDAR_TDV=""
